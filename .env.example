# GEMINI_API_KEY: Solo si se requieren llamadas a Gemini API en el backend
GEMINI_API_KEY=

# APP_URL: URL del entorno
APP_URL=

# URL de Google Sheets para sincronización automática de cursos (opcional)
VITE_GOOGLE_SHEET_URL=

# Contraseña de acceso a la ruta de administración (/admin o #admin, opcional)
VITE_ADMIN_PASSWORD=
